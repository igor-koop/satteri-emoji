{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "satteri-emoji",
  "version": "0.2.1",
  "private": false,
  "description": "Satteri plugin to replace emoji shortcodes and emoticons in Markdown text.",
  "keywords": [
    "emoji",
    "emoticon",
    "markdown",
    "mdast",
    "mdx",
    "satteri",
    "shortcode"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/igor-koop/satteri-emoji.git"
  },
  "files": [
    "dist/*.d.ts",
    "dist/*.js"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "test": "vitest run",
    "cov": "vitest run --coverage"
  },
  "devDependencies": {
    "@types/node": "^26.5.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@types/regexgen": "^1.3.3",
    "@vitest/coverage-v8": "^5.0.0",
    "emojibase": "^17.0.0",
    "emojibase-data": "^17.0.0",
    "oxfmt": "^0.67.0",
    "oxlint": "^1.82.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "regexgen": "^1.3.0",
    "satteri": "^0.10.5",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  },
  "peerDependencies": {
    "satteri": ">=0.7.0 <0.11.0"
  },
  "engines": {
    "node": ">=22"
  }
}
